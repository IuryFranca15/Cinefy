# Copie este arquivo para .streamlit/secrets.toml no desenvolvimento local.
# Nunca envie o secrets.toml real ao GitHub.

[spotify]
client_id = "COLOQUE_SEU_CLIENT_ID"
client_secret = "COLOQUE_SEU_CLIENT_SECRET"
# Para desenvolvimento local (o Spotify não aceita mais "localhost"; use o IP de loopback):
redirect_uri = "http://127.0.0.1:8501"
# Para Streamlit Cloud, altere para a URL publicada, por exemplo:
# redirect_uri = "https://seu-cinefy.streamlit.app"

[database]
# Opcional localmente: deixe vazio para usar SQLite.
# Na nuvem, use o connection string PostgreSQL do Supabase.
url = ""

[app]
# Recomendado para implantação pública: defina uma senha forte.
password = ""

[tmdb]
# API Read Access Token (Bearer) recomendado. Obtenha em TMDB > Settings > API.
bearer_token = "COLOQUE_SEU_API_READ_ACCESS_TOKEN"
# Alternativamente, use api_key em vez de bearer_token.
api_key = ""
